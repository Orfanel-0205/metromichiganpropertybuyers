# =====================================================================
# METRO MICHIGAN PROPERTY BUYERS - BACKEND ENVIRONMENT
# =====================================================================
# Copy to backend/.env for local development. NEVER commit a real .env.
# Placeholders only in this file - no real secrets, ever.
#
# WHERE EACH VARIABLE GOES
#   Render  - the API service (cash-home-buyer-website). Almost everything here.
#   Vercel  - the static site. It needs NOTHING from this file. The frontend
#             talks to the API through assets/js/config.js and holds no secrets.
#   Local   - backend/.env on a developer machine.
#
# Anything below is readable by the server only. Nothing here may ever be
# inlined into a page or exposed to browser JavaScript.

# ---------------------------------------------------------------------
# CORE  (Render: required)
# ---------------------------------------------------------------------
PORT=5000
# Set to "production" on Render. This also makes the server refuse to start
# without a real JWT_SECRET, which is the point.
NODE_ENV=development

# ---------------------------------------------------------------------
# DATABASE - MongoDB Atlas  (Render: REQUIRED)
# ---------------------------------------------------------------------
# The permanent store for every lead and admin account.
# Include the database name after the host. URL-encode any characters in the
# username or password that are reserved in a URI (@ : / ? # [ ] %).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority&appName=<app-name>
# Optional comma-separated DNS resolvers for mongodb+srv SRV lookups. Only needed
# when the host's own resolver cannot answer SRV queries.
MONGODB_DNS_SERVERS=1.1.1.1,1.0.0.1,8.8.8.8,8.8.4.4

# ---------------------------------------------------------------------
# AUTHENTICATION  (Render: REQUIRED)
# ---------------------------------------------------------------------
# Signs admin session tokens. Must be at least 32 characters; in production the
# server exits rather than start without one. Generate with:
#   openssl rand -hex 48
# Changing it signs every admin out, which is the emergency lever if a token leaks.
JWT_SECRET=
# How long an admin session lasts. Default 8h.
JWT_EXPIRES_IN=8h
# Failed logins allowed per IP per 15 minutes. Successful ones are not counted.
LOGIN_RATE_LIMIT=10

# ---------------------------------------------------------------------
# FIRST ADMIN BOOTSTRAP  (Render: optional, temporary)
# ---------------------------------------------------------------------
# Only used when the database has no admin accounts at all. Prefer running
# `npm run bootstrap-admin`, which prompts for the password so it is never
# written to a file or a dashboard. If you do set these, REMOVE ADMIN_PASSWORD
# once the account exists.
# The account created this way is a Super Admin, so it can create the others.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_FULL_NAME=System Administrator

# ---------------------------------------------------------------------
# LEAD NOTIFICATIONS  (Render: REQUIRED for anyone to hear about a lead)
# ---------------------------------------------------------------------
# >>> THIS is the address new seller leads are emailed to. <<<
# Set it to the company/owner address. Several addresses may be listed,
# comma-separated:
#   LEAD_NOTIFICATION_EMAIL=owner@example.com,office@example.com
# If it is empty, ADMIN_EMAIL is used as a fallback; if that is empty too, leads
# are still saved to MongoDB and visible in the dashboard, but nobody is emailed.
LEAD_NOTIFICATION_EMAIL=
# Optional. Contact-form messages go here instead, when set.
CONTACT_NOTIFICATION_EMAIL=

# ---------------------------------------------------------------------
# EMAIL TRANSPORT - Resend  (Render: REQUIRED)
# ---------------------------------------------------------------------
# Render blocks outbound SMTP, so Resend over HTTPS is the only transport that
# works there. Key from https://resend.com/api-keys
RESEND_API_KEY=
# Sender address. Until a domain is verified with Resend, their shared
# onboarding@resend.dev works but delivers ONLY to the Resend account owner.
# Verify metromichiganpropertybuyers.com and use an address on it to reach anyone.
RESEND_FROM=Metro Michigan Property Buyers <onboarding@resend.dev>
# Milliseconds before an email send is abandoned.
EMAIL_TIMEOUT_MS=15000

# ---------------------------------------------------------------------
# EMAIL TRANSPORT - SMTP fallback  (Local only)
# ---------------------------------------------------------------------
# Used only when RESEND_API_KEY is empty. Fine for local development.
EMAIL_SERVICE=gmail
EMAIL_USER=
# A Gmail App Password, not the account password.
EMAIL_PASS=
EMAIL_FROM=

# ---------------------------------------------------------------------
# CORS / FRONTEND  (Render: recommended)
# ---------------------------------------------------------------------
# https://metromichiganpropertybuyers.com and its www form are allowed by the
# code itself (backend/config/origins.js), so the live site works even if these
# are unset. Use these to add anything else.
FRONTEND_URL=https://metromichiganpropertybuyers.com
# Comma-separated extra origins. No trailing slashes.
ALLOWED_ORIGINS=https://michiganpropertybuyers.vercel.app
# Set to false to stop auto-allowing *.vercel.app preview deployments.
ALLOW_VERCEL_PREVIEWS=true
# Proxy hops to trust for client IPs (Render/Railway/Fly = 1). Wrong values break
# rate limiting, because every request appears to come from the proxy.
TRUST_PROXY_HOPS=1

# ---------------------------------------------------------------------
# RATE LIMITS  (Render: optional)
# ---------------------------------------------------------------------
# Lead submissions allowed per IP per 15 minutes.
LEAD_RATE_LIMIT=10
# Contact-form submissions per IP per 15 minutes.
CONTACT_RATE_LIMIT=5
# Authenticated SMS sends per hour.
SMS_RATE_LIMIT_PER_HOUR=30

# ---------------------------------------------------------------------
# SMS - ClickSend  (Render: optional)
# ---------------------------------------------------------------------
# Without these, SMS is skipped and leads are unaffected.
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
CLICKSEND_FROM_NUMBER=MetroMich
# Where new-lead SMS alerts go.
RECIPIENT_PHONE=
ADMIN_PHONE=
SEND_SMS=false

# ---------------------------------------------------------------------
# CHAT ASSISTANT - Google Gemini  (Render: optional)
# ---------------------------------------------------------------------
# Server-side only. Never expose this to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Chat messages allowed per IP per minute.
CHAT_RATE_LIMIT_PER_MIN=10
# Persist chat transcripts to the ChatLog collection.
CHAT_LOG_ENABLED=false
CHAT_LOG_TTL_DAYS=90

# ---------------------------------------------------------------------
# SUPABASE - secondary lead-contact mirror  (Render: optional)
# ---------------------------------------------------------------------
# A best-effort copy of contact details only. MongoDB stays the source of truth;
# a Supabase failure is logged and never fails a lead submission.
# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=
# SECRET / service-role key. Bypasses row level security - backend only.
# Never expose this to the frontend and never commit a real value.
SUPABASE_SECRET_KEY=
SUPABASE_TIMEOUT_MS=5000
